---
import '../styles/landing.css';
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="dark" />
    <meta name="robots" content="noindex" />
    <title>Page not found — BrowserThing</title>
    <link rel="icon" type="image/svg+xml" href={`${base}browserthing-icon.svg`} />
  </head>
  <body>
    <main>
      <h1>Page not found</h1>
      <p>This address does not match a page on the site.</p>
      <nav aria-label="Site links"><a href={base}>BrowserThing</a><a href={`${base}docs/`}>Documentation</a></nav>
    </main>
  </body>
</html>

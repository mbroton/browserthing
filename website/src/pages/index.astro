---
import Architecture from '../components/Architecture.astro';
import '../styles/landing.css';

const base = import.meta.env.BASE_URL;
const repo = 'https://github.com/mbroton/browserthing';
const headline = 'Use Playwright in your app. Run browsers elsewhere.';
const description = 'A self-hosted browser pool for Playwright applications. Reuse running browsers for short tasks, with session cleanup and configurable browser recycling.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="dark" />
    <title>{`BrowserThing — ${headline}`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(base, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href={`${base}browserthing-icon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`BrowserThing — ${headline}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(base, Astro.site)} />
    <meta name="theme-color" content="#111111" />
  </head>
  <body>
    <main>
      <h1>BrowserThing</h1>
      <p class="description">{headline}</p>

      <nav aria-label="Project links">
        <a href={`${base}docs/`}>Documentation</a>
        <a href={`${base}docs/benchmarks/`}>Benchmarks</a>
        <a href={repo}>GitHub</a>
        <a href={`${repo}/releases`}>Releases</a>
      </nav>

      <p>
        {description}
      </p>

      <p>
        BrowserThing was built for applications that run many short browser tasks.
        Starting a new browser each time adds time and CPU use. Keeping the same
        browser running indefinitely can let memory use grow or leave it in a bad
        state. BrowserThing reuses running browsers and replaces them after a
        configurable number of sessions.
      </p>

      <p>
        Write normal Playwright code and connect through one WebSocket endpoint.
        BrowserThing selects an available worker and cleans up each session when
        its connection closes. Several applications can share the same internal
        service.
      </p>

      <p>
        Run workers on separate machines to keep browser CPU and memory use off
        your application servers. Add workers when you need more browser capacity,
        independently of your application instances.
      </p>

      <Architecture />

      <p class="note">
        You deploy and update the service for your own applications and trusted
        clients. Browser contexts separate cookies and storage, but sessions
        share a browser process on each worker. See the <a href={`${base}docs/security/`}>security boundary</a>.
        Connect your application with the <a href={`${base}docs/quick-start/`}>quick start</a>.
      </p>

      <footer>
        <span>Built by <a href="https://broton.dev">mbroton</a></span>
      </footer>
    </main>
  </body>
</html>

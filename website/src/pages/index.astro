---
import Architecture from '../components/Architecture.astro';
import '../styles/landing.css';

const base = import.meta.env.BASE_URL;
const repo = 'https://github.com/mbroton/browserthing';
const headline = 'Use Playwright in your app. Run browsers elsewhere.';
const description = 'A self-hosted browser service for Playwright. Use browsers from your application code while BrowserThing runs and manages them on separate workers.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="dark" />
    <title>{`BrowserThing — ${headline}`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(base, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href={`${base}browserthing-icon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`BrowserThing — ${headline}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(base, Astro.site)} />
    <meta name="theme-color" content="#111111" />
  </head>
  <body>
    <main>
      <h1>BrowserThing</h1>
      <p class="description">{headline}</p>

      <nav aria-label="Project links">
        <a href={`${base}docs/`}>Documentation</a>
        <a href={`${base}docs/benchmarks/`}>Benchmarks</a>
        <a href={repo}>GitHub</a>
        <a href={`${repo}/releases`}>Releases</a>
      </nav>

      <p>
        {description}
      </p>

      <p>
        Connect through one endpoint and control the browser with Playwright.
        BrowserThing keeps browsers running between tasks and handles session
        cleanup and browser recycling. Several applications can share the same
        internal service.
      </p>

      <p>
        Run workers on separate machines to keep browser CPU and memory use off
        your application servers. Add workers when you need more browser capacity,
        independently of your application instances.
      </p>

      <Architecture />

      <p class="note">
        You deploy and update the service. Sessions use separate browser contexts
        and share a browser process on each worker. See the <a href={`${base}docs/security/`}>security boundary</a>.
        Connect your application with the <a href={`${base}docs/quick-start/`}>quick start</a>.
      </p>

      <footer>
        <span>Built by <a href="https://broton.dev">mbroton</a></span>
      </footer>
    </main>
  </body>
</html>
